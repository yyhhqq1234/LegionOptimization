# Runtime log files (generated at runtime)
update_log.txt
switch_log.txt
watcher_log.txt

# Runtime lock files
*.lock

# Runtime pid files
*.pid

# Agent harness state (never commit)
.agent-teams/

# ThrottleStop runtime files (overwritten on every mode switch)
ThrottleStop/ThrottleStop.ini
ThrottleStop/Logs/

# Build artifacts
*.pdb

# Visual Studio
.vs/
*.user
*.suo

# .NET
*.nupkg
*.snupkg

# OS files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Backup files
*.backup.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# P3: artifacts 大文件忽略，只留 README 与小样例
artifacts/*
!artifacts/README.md
!artifacts/samples/

# P4 r27: PresentMon 便携 exe 本体（~1MB 二进制）不进仓，只留 README + 下载命令
tools/presentmon/*.exe
tools/presentmon/*.zip

# P4 r30: PresentMon 原始帧 CSV 是大文件（一次窗口 3MB+），只留影子 JSONL 与报告样例
artifacts/samples/pm_*.csv

# P4 r33: 影子 run 的逐 tick JSONL 也偏大（900s ≈ 620KB）；只留结论型 JSON（report/summary）
artifacts/samples/e4_shadow_*.jsonl

# 本地私有内容（AGENTS.md 铁律 10：新增私有内容必须即时补 ignore）
*.local.*
*.private.*
private/
local-private/
